{
  "manifest_version": 2,
  "name": "Crates Packer",
  "version": "1.0",
  "description": "Save crates.io pages to file",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "*://crates.io/*"
  ],
  
  "browser_action": {
    "default_title": "Save Crate",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  
  "icons": {
    "48": "icons/about-48.png",
    "96": "icons/about-96.png"
  },
  
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  
  "content_scripts": [
    {
      "matches": ["*://crates.io/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  
  "browser_specific_settings": {
    "gecko": {
      "id": "crates-packer@yourdomain.com",
      "strict_min_version": "91.0"
    }
  }
}
